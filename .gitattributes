
# Published phone pages are served and checked byte for byte (apaki/engine/remote-page.js):
# never convert their line endings, or a checkout on Windows would break every hash.
relay/site/** -text

# The iOS pipeline's shell scripts run on the Mac and on a GitHub macOS runner: LF only, even when checked out on Windows.
apaki/mobile/scripts/*.sh text eol=lf

# Parity snapshots are compared byte for byte with their canonical form (test/apaki-parity.test.js): LF only,
# or a fresh checkout on Windows (an agent worktree) fails that test (2026-10-12).
apaki/parity/snapshots/** text eol=lf

# The macOS packaging script runs on a Mac and on a GitHub macOS runner: LF only, even when checked out on Windows.
apaki/scripts/*.sh text eol=lf

# Vendored xterm.js (apaki/ui/vendor/xterm/LICENSE.txt lists each file's sha256 as published): kept byte for byte.
apaki/ui/vendor/xterm/*.js -text
apaki/ui/vendor/xterm/*.css -text
