{
  "name": "claude-latch",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "A terminal UI that latches onto an existing Claude Code session and continues it on an Anthropic API key, with Claude Code's own tools, settings and hooks.",
  "type": "module",
  "bin": {
    "latch": "bin/latch.js"
  },
  "scripts": {
    "start": "node bin/latch.js",
    "test": "node --test",
    "parity:extract": "node apaki/parity/extract.mjs",
    "parity:diff": "node apaki/parity/diff.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.295",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/headless": "6.0.0",
    "htm": "^3.1.1",
    "ink": "^6.8.0",
    "node-pty": "1.1.0",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "ink-testing-library": "^4.0.0"
  }
}
