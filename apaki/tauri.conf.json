{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Myrlin Apaki",
  "version": "1.0.0",
  "identifier": "io.myrlin.apaki",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Myrlin Apaki",
        "url": "index.html",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob: http://127.0.0.1:*; frame-src http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA0RkMzQThDNzM3MUE5OTgKUldTWXFYRnpqRHI4Qk1WQUUvM3NJMXdSbUtvZ3k5eWJaQUdlREdoUG8zY3NlMVRpZHdaOXI4MlcK",
      "endpoints": [
        "https://github.com/therealarthur/apaki/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
